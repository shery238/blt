# Public site URL (used for canonical URLs, sitemap and structured data)
NEXT_PUBLIC_SITE_URL=https://businesstechltd.co.uk

# Show draft use cases, solutions and insights (badged + noindex). Set to "false" for launch
# once content has editorial approval.
NEXT_PUBLIC_SHOW_DRAFTS=true

# Contact form email delivery via Resend (https://resend.com). Without a key, submissions
# are logged in development and rejected in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional Cloudflare Turnstile spam protection (both required to enable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional privacy-friendly analytics (Plausible). Loaded only after cookie consent.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_HOST=https://plausible.io

# Google Search Console verification token (content of the google-site-verification meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
